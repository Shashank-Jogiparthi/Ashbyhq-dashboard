# =====================================================================
# ApplyWizz dashboard — configuration template.
# Copy to .env (same folder) and fill in. Every value is optional: the
# server boots fine with none of it; the DB connector + worker simply
# stay off until you configure them.
# =====================================================================

# --- Server ----------------------------------------------------------
PORT=3100

# --- Parallel automation worker --------------------------------------
# WORKER_ENABLED=true makes the runner claim QUEUED applications the
# moment a CA clicks APPLY and spawn one browser child per application
# (true concurrency, no sequence). Leave false to keep runs manual.
WORKER_ENABLED=false
# Max browsers allowed at once (bounded semaphore; extra QUEUED rows
# wait for the next free slot but are still picked up live). This is a
# CEILING, not a guarantee: core/host-capacity.js measures the memory this
# host can really use and never runs more browsers than fit (a 512MB
# container gets 1, "unlimited" means "as many as fit").
MAX_CONCURRENT_RUNS=4
# How often the poll loop re-checks the QUEUED queue (ms).
WORKER_POLL_MS=8000
# Path to the base-layer engine. Defaults to ../ashby-hybrid-automation.js
# ENGINE_PATH=C:\Users\you\Downloads\AshByHq\ashby-hybrid-automation.js

# --- Link PRE-SCAN worker (questions -> ashby_joblink_questions) ------
# A separate durable queue (table link_scan_jobs): pasting an (AWL-ID -> link)
# pair only records an intent; this worker claims one link at a time, scans its
# questions and then pre-warms the draft answers for every applicant waiting on
# that link, so the CA pane opens pre-filled and only the unknowns are left.
AUTO_SCAN_ON_LINK=true
# Scans capture form STRUCTURE only (nothing typed, nothing submitted) so they
# run headless and never steal the operator's screen. Set false to watch it.
SCAN_HEADLESS=true
# Also run the deterministic + GenAI draft pass after a scan lands.
SCAN_PREWARM_DRAFTS=true
# How many links are scanned AT THE SAME TIME. Separate budget from the headed
# APPLY workers (MAX_CONCURRENT_RUNS): neither waits for the other, so the real
# ceiling is the machine (worst case 4 apply + 3 scan Chromiums at once).
SCAN_CONCURRENCY=3
SCAN_POLL_MS=8000
# One scan is presumed dead after this long (its claim is then handed back).
SCAN_TIMEOUT_MS=900000

# --- External applicant DB (Azure PostgreSQL / pgAdmin) --------------
# Provide EITHER PG_CONNECTION_STRING OR the discrete PGHOST/PGUSER/...
# pair. When none is set, use the DEV "Data Sync" > Ingest box to load a
# single { client, additional_information } JSON export instead.
# PG_CONNECTION_STRING=postgresql://user:pass@host:5432/db?sslmode=require
# PGHOST=<your-azure-postgres-host>.postgres.database.azure.com
# PGPORT=5432
# PGUSER=<admin-user>
# PGPASSWORD=<password>
# PGDATABASE=<database>
# PGSSL=true            # set false only for a local, no-TLS test DB

# Which table/view holds the applicant documents (default: clients).
# PG_APPLICANTS_TABLE=clients
# Optional full override of the applicants query:
# PG_APPLICANTS_QUERY=SELECT * FROM public.clients
# Optional second query for (applywizz_id, url) job-link pairs:
# PG_LINKS_QUERY=SELECT applywizz_id, url, company, title FROM public.job_links_queue

# --- Hosted cache (Supabase Postgres) --------------------------------
# Without these the dashboard runs on local SQLite only.
# SUPA_DB_URL=postgresql://postgres.<ref>:<pass>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# SUPA_TLS_INSECURE=true      # the db.<ref>.supabase.co cert is private-CA
# DB_BACKEND=supabase         # explicit override; auto-detected from SUPA_DB_URL

# --- Run evidence screenshots (Supabase Storage) ---------------------
# One bucket, two interchangeable credential styles. S3 wins if both set.
#   a) S3 protocol  - Project Settings -> S3 Integrations (npm i nothing:
#                     SigV4 is signed in connector/supabase-s3.js)
# SUPA_S3_ENDPOINT=https://<ref>.storage.supabase.co/storage/v1/s3
# SUPA_S3_REGION=ap-south-1
# SUPA_S3_ACCESS_KEY=<key id>
# SUPA_S3_SECRET_KEY=<secret>
#   b) REST         - Project Settings -> API -> service_role secret
# SUPA_PROJECT_URL=https://<ref>.supabase.co
# SUPA_SERVICE_KEY=<service_role jwt>
# SUPA_SCREENSHOT_BUCKET=application-screenshots
# Create the public-read bucket once:  npm run setup:storage
# Prove the wiring any time (uploads + reads back + deletes a 1x1 PNG):
#   npm run storage:check

# --- Automation workers ----------------------------------------------
# Both workers poll durable DB queues; each drives its own browser budget.
# APPLY worker (one Chromium per queued application):
#   0 = as many browsers at once as this host can hold - the queue is drained
#   without a number in the way, and core/host-capacity.js still decides the
#   real count from the memory actually available. Default 4 (also clamped).
# MAX_CONCURRENT_RUNS=4
# RUN_START_SPACING_MS=1500   # ms between browser STARTS within one poll tick.
#   Applies on every host, capped or not: browsers that launch in the same second
#   are a RAM spike and, on the apply path, three identical simultaneous
#   submissions from one IP - which is what Ashby's filter flags as spam.
#   0 disables the stagger.
# APPLY_HEADLESS=true         # hidden apply browsers. Leave it UNSET and the
#   platform decides per host (core/apply-mode.js): a linux box with no DISPLAY
#   or WAYLAND_DISPLAY applies headless, anything else opens a real window -
#   which is the safer anti-spam signal. Set it explicitly to override either
#   way; APPLY_HEADLESS=false on a container means "give me a window" and the
#   capability probe will then honestly report that host as unable to apply.
#   Neither mode hides the IP: a datacenter host gets submissions flagged as
#   possible spam more often, and such a run is named and left PENDING for a
#   human (core/submission-banner.js) rather than retried from the same address.
# APPLY_DEFER_MS=300000       # pause before an application handed back to the
#   queue by a host with no usable browser is retried. Without it the same
#   dead host re-claims the same row every poll tick.
# WORKER_POLL_MS=8000

# --- How many browsers THIS host can hold (core/host-capacity.js) ----
# Measured automatically; these knobs only override the measurement for an
# operator who knows better than the heuristic.
# MAX_BROWSERS=1            # ceiling on browsers at once for this host. Each
#                           # worker is capped by it separately (the scanner at
#                           # most half), so apply 1 + scan 1 is still 2 live
#                           # Chromiums on a 1-browser host - the estimate is
#                           # deliberately conservative, and a run killed by
#                           # memory pressure is handed back rather than
#                           # recorded as an applicant's failure.
# APPLY_BROWSER_MB=512      # memory budgeted per Chromium (default 512)
# HOST_MEM_MB=512           # pretend the host has this much memory. Otherwise
#                           # a container limit is read from the cgroup, with
#                           # os.totalmem() as the fallback - and inside a
#                           # container os.totalmem reports the HOST NODE, which
#                           # is why a 512MB service needs this to stay honest.
# Pre-scan worker (form STRUCTURE only, never submits) - headless by default:
# AUTO_SCAN_ON_LINK=true
# SCAN_CONCURRENCY=3
# SCAN_HEADLESS=true
# SCAN_PREWARM_DRAFTS=true

# --- Container paths (set only when not running from a repo checkout) --
# ENGINE_PATH=/app/ashby-hybrid-automation.js
# RUN_TMP_DIR=/tmp/applywizz-runs
# RESUME_CACHE_DIR=/tmp/resume-cache
# CHROME_PATH=               # leave unset to use Playwright's bundled Chromium
