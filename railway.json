{
  "$schema": "https://raw.githubusercontent.com/railwayapp/railway-json-schema/main/schema/latest/schema.json",
  "deploy": {
    "startCommand": "node ashbyhq-dashboard/server.js",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  },
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm install && npm install --prefix ashbyhq-dashboard"
  }
}
